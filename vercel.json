{
  "rewrites": [
    {
      "source": "/games/(.*)",
      "destination": "/games/$1/index.html"
    },
    {
      "source": "/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}